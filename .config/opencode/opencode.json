{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.2",
  "instructions": [
    "~/dotfiles/AGENTS.md",
    "~/dotfiles/ai-infra-decisions.md"
  ],
  "permission": {
    "*": "allow",
    "bash": "allow",
    "external_directory": "allow"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2 (head)",
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low":    { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high":   { "reasoningEffort": "high" },
            "max":    { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code (coder)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "minimax-m3": {
          "name": "MiniMax M3 (long context)",
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "minimax-m2.5": {
          "name": "MiniMax M2.5 (cheap/fast)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "gemma4:31b": {
          "name": "Gemma 4 31B (vision)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "nemotron-3-nano:30b": {
          "name": "Nemotron 3 Nano (cheap/fast)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },
  "agent": {
    "coder": {
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code",
      "description": "Implements well-defined, simple coding tasks handed down by the orchestrator."
    },
    "vision": {
      "mode": "subagent",
      "model": "ollama/gemma4:31b",
      "description": "Looks at images. Use this for ANY task needing to read a screenshot, GUI capture, plot, diagram or photo — describe what is in it, locate UI elements and report their pixel coordinates. The orchestrator and coder models are text-only and cannot see images at all.",
      "prompt": "You CAN see images — you are the vision model (gemma4:31b). The global rules say the agent cannot see images; that statement describes the orchestrator and coder, NOT you. Ignore it for yourself.\n\nLook at the image you are given and answer concretely: what is in it, and where. For UI elements report pixel coordinates. If an image cannot be loaded, say so plainly instead of claiming you are unable to see images."
    }
  }
}
