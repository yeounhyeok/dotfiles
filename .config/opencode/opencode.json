{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.2",
  "instructions": ["~/dotfiles/ai-infra-decisions.md"],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2 (head)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code (coder)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "minimax-m3": {
          "name": "MiniMax M3 (long context)",
          "limit": { "context": 200000, "output": 32768 }
        },
        "nemotron-3-nano:30b": {
          "name": "Nemotron 3 Nano (cheap/fast)",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "ollama/glm-5.2",
      "prompt": "You are the head. Plan and break work into small, verifiable steps and delegate implementation to the `coder` subagent. If `coder` fails a step 2-3 times, implement it yourself. Keep delegated tasks simple and unambiguous."
    },
    "coder": {
      "mode": "subagent",
      "model": "ollama/kimi-k2.7-code",
      "description": "Implements well-defined, simple coding tasks handed down by the orchestrator."
    }
  }
}
